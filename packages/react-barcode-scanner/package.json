{
  "name": "react-barcode-scanner",
  "version": "4.1.0",
  "description": "A barcode scanner base on Barcode Detector",
  "keywords": [
    "react",
    "barcode detector",
    "barcode-detector",
    "barcode scanner",
    "barcode-scanner",
    "qrcode"
  ],
  "license": "MIT",
  "homepage": "https://reactbarcodescanner.vercel.app/",
  "bugs": {
    "url": "https://github.com/preflower/react-barcode-scanner/issues"
  },
  "repository": "https://github.com/preflower/react-barcode-scanner",
  "author": "Ted Lin <preflower.lin@gmail.com> (https://github.com/preflower)",
  "type": "module",
  "files": [
    "dist/"
  ],
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./polyfill": {
      "import": {
        "types": "./dist/polyfill.d.ts",
        "default": "./dist/polyfill.js"
      },
      "require": {
        "types": "./dist/polyfill.d.cts",
        "default": "./dist/polyfill.cjs"
      },
      "default": "./dist/polyfill.js"
    }
  },
  "typings": "dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "test": "pnpm build && vp test run tests/use-atom.test.ts tests/scanner-store.test.ts tests/provider-ssr.test.tsx && node --test tests/core.test.cjs"
  },
  "peerDependencies": {
    "react": "*",
    "react-dom": "*"
  },
  "dependencies": {
    "@undecaf/zbar-wasm": "^0.11.0",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@preflower/barcode-detector-polyfill": "^0.9.21",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite-plus": "^0.2.9"
  }
}
